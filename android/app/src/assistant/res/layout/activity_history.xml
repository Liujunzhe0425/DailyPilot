<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="运行历史（保留 30 天）" android:textSize="24sp" android:textStyle="bold" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><TextView android:id="@+id/history_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="16dp" /></ScrollView>
    <Button android:id="@+id/clear_history" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="清理日志与截图" />
</LinearLayout>
